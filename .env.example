
# Telegram Config
BOT_TOKEN=12345:xxxXXX
PROVIDER_TOKEN=1234:TEST:xyyyx

# Database Config
DB_NAME=telegram_ecommerce
DB_HOST=db
DB_PORT=5432
DB_USER=bot-user
DB_PASSWORD=bot-user-1234

# App Config
# Comma-separated numeric Telegram user IDs. Usernames are not stable identities.
ADMIN_USER_IDS=

# Optional owner demo mode: one brand per bot instance. Leave empty for normal shop.
# dailyobjects, blue_tokai, nicobar, ellementry, or jaipur_rugs
DEMO_BRAND=

# Optional catalog assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_INTENT_MODEL=gpt-6-luna
# These models support none; choose a supported effort if overriding the models.
OPENAI_REASONING_EFFORT=none

# Request routing: bounded Decisions classification, then lightweight read-only answers.
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_READ_MODEL=gpt-6-luna

# Optional read-only catalog Mini App. HTTPS required for Telegram buttons.
MINI_APP_URL=
BOT_USERNAME=
MINI_APP_PORT=8088
