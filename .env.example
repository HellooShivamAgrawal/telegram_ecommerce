
# Telegram Config
BOT_TOKEN=12345:xxxXXX
PROVIDER_TOKEN=1234:TEST:xyyyx

# Database Config
DB_NAME=telegram_ecommerce
DB_HOST=db
DB_PORT=5432
DB_USER=bot-user
DB_PASSWORD=bot-user-1234

# App Config
# Comma-separated numeric Telegram user IDs. Usernames are not stable identities.
ADMIN_USER_IDS=

# Optional catalog assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_INTENT_MODEL=gpt-6-luna
OPENAI_FAST_MODEL=gpt-6-luna
# Experimental advisory routing; off until representative evaluations justify it.
OPENAI_DECISIONS_ROUTING=false
# These models support none; choose a supported effort if overriding the models.
OPENAI_REASONING_EFFORT=none
